//pins
#define MOT_A1_PIN 5
#define MOT_A2_PIN 6
#define MOT_B1_PIN 9
#define MOT_B2_PIN 10

//motors
int leftServoSpeed = 0;
int rightServoSpeed = 0;

//sensor
const int irPins[3] = {A5, A4, A3};

int irSensorDigital[3] = {0, 0, 0};
int irSensorRaw[3] = {0, 0, 0};

int threshold = 500;
const int maxSpeed = 180;

int irSensors = B000;
int error = 0;
int errorLast = 0;


void setup() {
  pinMode(MOT_A1_PIN, OUTPUT);
  pinMode(MOT_A2_PIN, OUTPUT);
  pinMode(MOT_B1_PIN, OUTPUT);
  pinMode(MOT_B2_PIN, OUTPUT);

  Serial.begin(9600);
}

//motor control
void set_motor_pwm(int pwm, int IN1_PIN, int IN2_PIN) {
  if (pwm < 0) {
    analogWrite(IN1_PIN, -pwm);
    digitalWrite(IN2_PIN, LOW);
  } else {
    digitalWrite(IN1_PIN, LOW);
    analogWrite(IN2_PIN, pwm);
  }
}

void set_motor_currents(int pwm_A, int pwm_B) {
  set_motor_pwm(pwm_A, MOT_A1_PIN, MOT_A2_PIN);
  set_motor_pwm(pwm_B, MOT_B1_PIN, MOT_B2_PIN);
}

void spin_and_wait(int pwm_A, int pwm_B, int duration) {
  set_motor_currents(pwm_A, pwm_B);
  delay(duration);
}

//sensor scanning
void Scan() {
  irSensors = B000;

  for (int i = 0; i < 3; i++) {
    irSensorRaw[i] = analogRead(irPins[i]);
    irSensorDigital[i] = (irSensorRaw[i] >= threshold) ? 1 : 0;

    int b = 2 - i;
    irSensors |= (irSensorDigital[i] << b);
  }

  Serial.print("IR raw: L=");
  Serial.print(irSensorRaw[0]);
  Serial.print(" C=");
  Serial.print(irSensorRaw[1]);
  Serial.print(" R=");
  Serial.print(irSensorRaw[2]);

  Serial.print(" | dig: ");
  Serial.print(irSensorDigital[0]);
  Serial.print(" ");
  Serial.print(irSensorDigital[1]);
  Serial.print(" ");
  Serial.print(irSensorDigital[2]);

  Serial.print(" | bin=");
  Serial.print(irSensors, BIN);

  Serial.print(" | err=");
  Serial.println(error);
}

//line following
void UpdateDirection() {

  errorLast = error;

  switch (irSensors) {

    case B000:  
      //off track
      if (errorLast < 0) {
        //off track to left
        leftServoSpeed  = -120;
        rightServoSpeed = 120;
      } 
      else {
        //off track to right
        leftServoSpeed  = 120;
        rightServoSpeed = -120;
      }
      return;

    case B100: error = -80; break;
    case B110: error = -40; break;
    case B010: error = 0;   break;
    case B011: error = 40;  break;
    case B001: error = 80;  break;
    case B111: error = 1;   break;
    default:   error = errorLast;
  }

  //smoothing turning
  if (error >= 0) {
    leftServoSpeed = maxSpeed;
    rightServoSpeed = maxSpeed - error;
  } else {
    leftServoSpeed = maxSpeed + error;
    rightServoSpeed = maxSpeed;
  }
}


//main loop
void loop() {
  Scan();
  UpdateDirection();
  spin_and_wait(leftServoSpeed, rightServoSpeed, 8);
}
